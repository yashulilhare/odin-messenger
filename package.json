{
  "name": "odin-messenger",
  "version": "1.0.0",
  "description": "A realtime chat application similar to Telegram, WhatsApp and other",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "yashulilhare",
  "license": "ISC",
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    ".{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
