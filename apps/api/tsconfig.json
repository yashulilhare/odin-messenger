{
  "extends": "../../packages/config/tsconfig/node.json",
  "compilerOptions": {
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["./src/db/*"],
      "@services/*": ["./src/services/*"],
      "@shared/*": ["../../packages/shared/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
